<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.wpal.agent</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/wpal</string>
        <string>--config</string>
        <string>/etc/wpal/config.yaml</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>WorkingDirectory</key>
    <string>/var/lib/wpal</string>
    <key>StandardOutPath</key>
    <string>/var/log/wpal.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/wpal.log</string>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
